/* Callout 样式 */
.callout
  border 1px solid rgba(0,0,0,0.06)
  border-left 4px solid #90caf9
  background #f6fbff
  padding 1rem
  margin 1rem 0
  border-radius 8px
  color #1f2d3d
  line-height 1.6

.callout-title
  display flex
  align-items center
  gap 0.5rem
  margin-bottom 0.5rem
  font-weight 600
  font-size 0.98rem

.callout-title-icon
  display inline-flex
  align-items center
  justify-content center
  width 1.6rem
  height 1.6rem
  border-radius 50%
  background rgba(0,0,0,0.03)
  flex-shrink 0

.callout-title-icon svg
  width 1rem
  height 1rem
  stroke currentColor
  display block

.callout-title-inner
  display inline-block

.callout-content
  margin 0
  color inherit
  font-size 0.95rem

.callout-content p
  margin 0 0 0.6rem 0

/* variants by data-callout */
.callout[data-callout="tip"]
  border-left-color #43a047
  background #f1fbf4
  color #163f22

.callout[data-callout="info"]
  border-left-color #1e88e5
  background #eef7ff
  color #0b3a5a

.callout[data-callout="warning"]
  border-left-color #fb8c00
  background #fff7ea
  color #5a3600

.callout[data-callout="danger"]
  border-left-color #e53935
  background #fff4f4
  color #4a0f0f

/* small screens */
@media (max-width: 480px)
  .callout
    padding 0.75rem
    border-radius 6px
    font-size 0.95rem
